{
  "name": "shoplite",
  "private": true,
  "version": "1.0.0",
  "description": "ShopLite: demo target application for CausalDeploy",
  "workspaces": ["lib/*", "services/*"],
  "scripts": {
    "test": "node --test --test-force-exit \"lib/*/test/*.test.js\" \"services/*/test/*.test.js\" \"loadgen/test/*.test.js\"",
    "start:gateway": "node services/gateway/src/server.js",
    "start:orders": "node services/orders/src/server.js",
    "start:payments": "node services/payments/src/server.js"
  },
  "engines": { "node": ">=20" }
}
